<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gordle"
        Arguments=""
        InstallLocation="C:\Program Files\NimaEskandary\Gordle">
    </Installer>
    <PackageInformation
        PackageName="Gordle"
        PackageDisplayName="Gordle"
        PublisherName="CN=NimaEskandary"
        PublisherDisplayName="NimaEskandary"
        Version="0.0.1.0"
        PackageDescription="Gordle">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.nimaeskandary.gordle"
                Description="Gordle"
                DisplayName="Gordle"
                ExecutableName="gordle"
                EntryPoint="Windows.FullTrustApplication">
                
