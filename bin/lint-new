#!/usr/bin/env bash
# Lints the files that have been staged for commit. Very useful as a pre-commit hook
set -euo pipefail

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJECT_ROOT_DIR="${SCRIPT_DIR}/.."

cd "${PROJECT_ROOT_DIR}"

GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
BIOME_FILES=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(js|jsx|ts|tsx)$' \
  | grep -v '^cmd/gordle_app/frontend/bindings/' || true)

if [[ -z "$GO_FILES" && -z "$BIOME_FILES" ]]; then
  exit 0
fi

if [[ -n "$GO_FILES" ]]; then
  echo "running go fix..."
  go fix ./...

  echo "Running gofmt..."
  gofmt -w $GO_FILES

  echo "Running golangci-lint..."
  # this needs to be run per package, not per file
  DIRS=$(echo "$GO_FILES" | xargs -n1 dirname | sort -u)

  for dir in $DIRS; do
    # these directories have go files that are meant to build with different os and arch flags, and
    # the same have to be provided to the linter. Accounting for that is complex.
    # just skipping linting these directories.
    case "$dir" in
      */build/android|*/build/ios)
        echo "Skipping Wails platform scaffold package: $dir"
        continue
        ;;
    esac

    go tool -modfile=./tools/golangci-lint/go.mod golangci-lint run "$dir" --fix
  done
fi

if [[ -n "$BIOME_FILES" ]]; then
  echo "Running Biome..."
  npx biome lint --write $BIOME_FILES
fi
