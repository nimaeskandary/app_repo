{
  "name": "wails3-react-polylith",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.5.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0 <12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "cmd/gordle/frontend",
    "storybook"
  ],
  "scripts": {
    "wails-app:dev": "npm --workspace @wails3-react-polylith/apps-wails-app-frontend run dev",
    "wails-app:build": "npm --workspace @wails3-react-polylith/apps-wails-app-frontend run build",
    "wails-app:build:dev": "npm --workspace @wails3-react-polylith/apps-wails-app-frontend run build:dev",
    "wails-app:preview": "npm --workspace @wails3-react-polylith/apps-wails-app-frontend run preview",
    "storybook": "npm --workspace @wails3-react-polylith/storybook run storybook",
    "build-storybook": "npm --workspace @wails3-react-polylith/storybook run build"
  },
  "dependencies": {
    "@wailsio/runtime": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "storybook": "^10.4.0",
    "tailwindcss": "4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.5"
  }
}
