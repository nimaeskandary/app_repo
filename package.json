{
  "name": "wails3-react-polylith",
  "private": true,
  "workspaces": [
    "bases/wails_app/frontend",
    "storybook"
  ],
  "scripts": {
    "wails-app:dev": "npm --workspace @wails3-react-polylith/bases-wails-app-frontend run dev",
    "wails-app:build": "npm --workspace @wails3-react-polylith/bases-wails-app-frontend run build",
    "wails-app:build:dev": "npm --workspace @wails3-react-polylith/bases-wails-app-frontend run build:dev",
    "wails-app:preview": "npm --workspace @wails3-react-polylith/bases-wails-app-frontend run preview",
    "storybook": "npm --workspace @wails3-react-polylith/storybook run storybook",
    "build-storybook": "npm --workspace @wails3-react-polylith/storybook run build"
  },
  "dependencies": {
    "@wailsio/runtime": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.5",
    "@storybook/react-vite": "^10.4.0",
    "storybook": "^10.4.0"
  }
}
