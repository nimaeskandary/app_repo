{
  "name": "app_repo",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.5.0 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0 <12",
      "onFail": "error"
    }
  },
  "workspaces": [
    "cmd/gordle_app/frontend",
    "pkg/gordle-frontend/ts",
    "pkg/ui/ts",
    "storybook"
  ],
  "scripts": {
    "storybook": "npm --workspace @app_repo/storybook run storybook",
    "build-storybook": "npm --workspace @app_repo/storybook run build"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.2.10",
    "@mui/material": "9.2.0",
    "@wailsio/runtime": "latest",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "storybook": "^10.4.0",
    "tailwindcss": "4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.5"
  }
}
